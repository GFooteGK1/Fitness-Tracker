# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by trusted cron/cleanup routes; never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM providers (server-only)
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
# Optional voice transcription model override
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Provider routing. Defaults to Anthropic when unset.
# LLM_PROVIDER=anthropic
# LLM_FAST_PROVIDER=openai
# LLM_WORKOUT_PROVIDER=openai
# LLM_NUTRITION_PROVIDER=openai
# LLM_VISION_PROVIDER=anthropic
# Optional per-provider/per-purpose model override, for example:
# LLM_OPENAI_NUTRITION_MODEL=gpt-5.4-nano
# LLM_ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# Google Sheets API (required for dynamic tab detection)
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key

# Google Sheets Cache TTL (optional - defaults to 4 hours)
# GOOGLE_SHEETS_CACHE_TTL_HOURS=4

# Trusted scheduled routes (server-only)
CRON_SECRET=your-secure-cron-secret
CLEANUP_TOKEN=your-secure-cleanup-token
